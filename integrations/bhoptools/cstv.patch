diff --git a/client/linux/Makefile b/client/linux/Makefile
index 17038e2..2b9edb9 100644
--- a/client/linux/Makefile
+++ b/client/linux/Makefile
@@ -49,3 +49,35 @@ clean:
 .PHONY: test
 test:
 	$(MAKE) -C ../tests test
+
+# CS:TV (in-world video screens) built in:  make CSTV_DIR=/path/to/cstv
+# CSTV_DIR = a CS:TV checkout (client/cstv_client.cpp, cstv_gui.cpp, cstv_capture.cpp, common/cstv_proto.h,
+# third_party/source-sdk-2013), no spaces in the path. Without CSTV_DIR nothing here applies and the build is
+# the one above, unchanged. -DBHOPTOOLS_CSTV goes to every source because it adds the cstv setting to
+# Settings. CS:TV's version script replaces preload.ver: the same "everything local", plus the one symbol the
+# stream capture exports (SDL_OpenAudioDevice: the engine's audio then goes through it, see cstv_capture.cpp).
+CSTV_DIR ?=
+ifneq ($(CSTV_DIR),)
+CSTV_SDK   := $(CSTV_DIR)/third_party/source-sdk-2013/src
+CSTV_FLAGS := -O2 -g -std=c++17 -fno-strict-aliasing -fPIC -m64 -fno-stack-protector \
+              -fvisibility=hidden -fvisibility-inlines-hidden -w \
+              -DPOSIX -DLINUX -D_LINUX -DGNUC -DCOMPILER_GCC -DPLATFORM_64BITS -DX64BITS \
+              -DNO_MALLOC_OVERRIDE -DCLIENT_DLL -DCSTV_EMBEDDED \
+              -I$(CSTV_SDK)/public -I$(CSTV_SDK)/public/tier0 -I$(CSTV_SDK)/public/tier1 \
+              -I$(CSTV_SDK)/common -I$(CSTV_DIR)/common -I$(CSTV_DIR)/client -I$(CSTV_DIR)/third_party/stb
+CXXFLAGS += -DBHOPTOOLS_CSTV -I$(CSTV_DIR)/client
+CSTV_OBJS := cstv_client.o cstv_gui.o cstv_capture.o
+SRCS += $(CSTV_OBJS)
+SO_FLAGS := $(subst --version-script=preload.ver,--version-script=$(CSTV_DIR)/client/cstv.ver,$(SO_FLAGS))
+
+$(SO_NAME): $(CSTV_OBJS) $(CSTV_DIR)/client/cstv.ver
+
+CSTV_HDRS := $(wildcard $(CSTV_DIR)/client/*.h) $(CSTV_DIR)/common/cstv_proto.h
+cstv_%.o: $(CSTV_DIR)/client/cstv_%.cpp $(CSTV_HDRS)
+	$(CXX) $(CSTV_FLAGS) -c $< -o $@
+
+clean: clean-cstv
+.PHONY: clean-cstv
+clean-cstv:
+	rm -f $(CSTV_OBJS)
+endif
