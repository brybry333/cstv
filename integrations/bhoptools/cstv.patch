diff --git a/client/windows/cstv_host.h b/client/windows/cstv_host.h
new file mode 100644
index 0000000..60c0d4b
--- /dev/null
+++ b/client/windows/cstv_host.h
@@ -0,0 +1,105 @@
+// cstv_host.h -- CS:TV (in-world video screens) for bhoptools.exe; only built with BHOPTOOLS_CSTV.
+//
+// CS:TV can't live inside this image (it is copied into the game without imports, TLS or static
+// init), so it is its own cstv_client.dll next to bhoptools.exe, with its helper in cstv\cstvd.exe
+// (the DLL starts that itself). The launcher half installs the screen material and notes where the
+// DLL is; the game half, in InjectionEntryPoint, loads it once speedo has hooked DispatchUserMessage:
+// the DLL hooks that function too, and speedo has to read the original first.
+#pragma once
+
+#include <Windows.h>
+#include <stdio.h>
+#include <string>
+#include "utils.h"
+
+namespace cstv_host {
+
+// Filled by the launcher before PEInjector copies this image into the game: a plain array travels
+// along with the copy, heap memory doesn't.
+static wchar_t g_dll[MAX_PATH];
+
+typedef int (*EnableFn)(int on);
+static EnableFn g_enable;
+
+static std::wstring ExeDir()
+{
+	wchar_t buf[MAX_PATH];
+	DWORD n = GetModuleFileNameW(NULL, buf, MAX_PATH);
+	std::wstring s(buf, n);
+	size_t slash = s.find_last_of(L"\\/");
+	return slash == std::wstring::npos ? L"." : s.substr(0, slash);
+}
+
+// Launcher. The screen material goes into cstrike\custom\cstv before the game starts (the game reads
+// custom\ folders only at startup, and fastdl mirrors don't carry it).
+static void Prepare(const std::string& css_path)
+{
+	const std::wstring dir = ExeDir();
+	const std::wstring dll = dir + L"\\cstv_client.dll";
+	if (GetFileAttributesW(dll.c_str()) == INVALID_FILE_ATTRIBUTES || dll.size() >= MAX_PATH)
+	{
+		printf("CS:TV: cstv_client.dll isn't next to bhoptools.exe, CS:TV is off\n");
+		return;
+	}
+	if (GetFileAttributesW((dir + L"\\cstv\\cstvd.exe").c_str()) == INVALID_FILE_ATTRIBUTES)
+		printf("CS:TV: cstv\\cstvd.exe is missing, the screens will stay blank\n");
+	wcscpy_s(g_dll, dll.c_str());
+
+	if (css_path.empty())
+		return;
+	const std::wstring src = dir + L"\\cstv\\materials\\cstv\\";
+	int n = MultiByteToWideChar(CP_ACP, 0, css_path.c_str(), -1, NULL, 0);
+	std::wstring dst(n > 0 ? n - 1 : 0, L'\0');
+	if (n > 0)
+		MultiByteToWideChar(CP_ACP, 0, css_path.c_str(), -1, &dst[0], n);
+	for (const wchar_t* part : { L"cstrike\\custom", L"\\cstv", L"\\materials", L"\\cstv" })
+	{
+		dst += part;
+		CreateDirectoryW(dst.c_str(), NULL);
+	}
+	int copied = 0;
+	for (const wchar_t* f : { L"screen.vmt", L"screen.vtf", L"chat.vmt", L"chat.vtf" })
+	{
+		std::wstring a = src + f, b = dst + L"\\" + f;
+		WIN32_FILE_ATTRIBUTE_DATA fa, fb;
+		if (!GetFileAttributesExW(a.c_str(), GetFileExInfoStandard, &fa))
+			continue;
+		bool same = GetFileAttributesExW(b.c_str(), GetFileExInfoStandard, &fb)
+			&& fa.nFileSizeLow == fb.nFileSizeLow && fa.nFileSizeHigh == fb.nFileSizeHigh;
+		if (!same && CopyFileW(a.c_str(), b.c_str(), FALSE))
+			copied++;
+	}
+	if (copied)
+		printf("CS:TV: installed the screen material into cstrike\\custom\\cstv (%d files)\n", copied);
+}
+
+// In the game, after speedo::Attach and the Detours commit.
+static bool Load(bool on)
+{
+	if (!g_dll[0])
+		return false;
+	HMODULE h = LoadLibraryW(g_dll);
+	if (!h)
+	{
+		CoreLog("CS:TV: couldn't load cstv_client.dll (error %lu)", GetLastError());
+		return false;
+	}
+	g_enable = reinterpret_cast<EnableFn>(GetProcAddress(h, "cstv_enable"));
+	if (!g_enable)
+	{
+		CoreLog("CS:TV: cstv_client.dll is too old (no cstv_enable)");
+		return false;
+	}
+	g_enable(on ? 1 : 0);
+	return true;
+}
+
+static bool Loaded() { return g_enable != nullptr; }
+
+static void Enable(bool on)
+{
+	if (g_enable)
+		g_enable(on ? 1 : 0);
+}
+
+}
